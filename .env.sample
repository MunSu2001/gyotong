# ─────────────────────────────────────────────────────────
# VACANT 환경변수 샘플
# cp .env.sample .env
# ─────────────────────────────────────────────────────────

# ─── LLM 설정 (OpenAI) ───────────────────────────────────
# 개발 시에만 4o-mini, 나중에 데모나 배포 때 4o로
LLM_MODEL=gpt-4o-mini

# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=


# ─── 데이터 경로 (선택) ────────────────────────────────────
# 기본값: 프로젝트 루트의 data/ 폴더
# DATA_DIR=/custom/path/to/data


# ─── 개발 모드 (선택) ────────────────────────────────────
# DEBUG=true 시 로그 레벨이 INFO → DEBUG 로 변경됨
# DEBUG=false